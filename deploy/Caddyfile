www.{$SITE_DOMAIN} {
  redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 14MB
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options SAMEORIGIN
    Strict-Transport-Security "max-age=31536000"
  }
  handle_path /recordings/authorize/* {
    forward_auth web:3000 {
      uri /api/recordings/authorization-check
    }
    reverse_proxy study-course-video-auth:6080
  }
  handle {
    reverse_proxy web:3000
  }
}
