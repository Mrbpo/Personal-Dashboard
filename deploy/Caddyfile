www.{$SITE_DOMAIN} {
  redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 14MB
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
  }
  reverse_proxy web:3000
}
